{
  "name": "eco-coding",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --cwd apps/desktop dev",
    "dev:server": "bun run --cwd apps/server dev",
    "dev:mobile": "cd apps/mobile && flutter run --flavor dev -d ios",
    "start:server": "bun run --cwd apps/server start",
    "build": "bun run --cwd apps/desktop build",
    "build:server": "bun run --cwd apps/server build:linux-amd64",
    "build:apk": "cd apps/mobile && flutter build apk --flavor prod",
    "deploy:server": "bash scripts/deploy-server.sh",
    "icons": "bun run --cwd apps/desktop icons",
    "pack:mac-arm64": "bun run --cwd apps/desktop pack:mac-arm64",
    "pack:win-x64": "bun run --cwd apps/desktop pack:win-x64",
    "pack:linux-x64": "bun run --cwd apps/desktop pack:linux-x64",
    "pack": "bun run --cwd apps/desktop pack",
    "test": "bun test",
    "test:agent-presets": "bun test apps/desktop/test/agent-preset-evals.test.ts apps/desktop/test/agent-preset-e2e.test.ts apps/desktop/test/agent-orchestration.test.ts packages/runtime/test/agent-orchestration.test.ts packages/runtime/test/eco-sdk-hooks.test.ts",
    "test:agent-e2e-offline": "bun test apps/desktop/test/agent-preset-e2e.test.ts",
    "test:agent-security": "bun test packages/runtime/test/agent-permission-redteam.test.ts packages/runtime/test/eco-sdk-hooks.test.ts",
    "test:agent-commercial": "bun test apps/desktop/test/agent-commercial-quality-gate.test.ts apps/desktop/test/agent-preset-evals.test.ts apps/desktop/test/agent-preset-e2e.test.ts apps/desktop/test/agent-profile-readiness.test.ts apps/desktop/test/agent-profile-archive.test.ts apps/desktop/test/agent-template-archive.test.ts apps/desktop/test/agent-profile-performance.test.ts apps/desktop/test/billing-diagnostics.test.ts apps/desktop/test/billing-projector.test.ts apps/desktop/test/usage-ledger-coordinator.test.ts apps/desktop/test/thread-run-projection-view.test.ts apps/desktop/test/usage-breakdown-panel.test.ts packages/runtime/test/agent-orchestration.test.ts packages/runtime/test/agent-permission-redteam.test.ts packages/runtime/test/eco-sdk-hooks.test.ts",
    "test:agent-ui-smoke": "bun run --cwd apps/desktop build && node apps/desktop/scripts/agent-ui-smoke.mjs",
    "dev:desktop:cdp": "bun run --cwd apps/desktop dev:cdp",
    "smoke:desktop-feed-loading": "bun run --cwd apps/desktop smoke:feed-loading",
    "smoke:desktop-subagent-drawer": "bun run --cwd apps/desktop smoke:subagent-drawer",
    "typecheck": "bunx tsc -b",
    "lint": "bunx biome check .",
    "format": "bunx biome format --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.16",
    "@types/bun": "^1.3.14",
    "@types/node": "^24.13.1",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.168",
    "zod": "^4.4.3"
  }
}
