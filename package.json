{
  "name": "eco-coding",
  "version": "0.0.1",
  "license": "MIT",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --cwd apps/desktop dev",
    "dev:demo": "bun run --cwd apps/desktop dev:demo",
    "dev:mobile": "cd apps/mobile && flutter run --flavor dev",
    "build": "bun run --cwd apps/desktop build",
    "build:apk": "cd apps/mobile && flutter build apk --flavor prod",
    "supabase:deploy": "node scripts/supabase-deploy.mjs",
    "icons": "bun run --cwd apps/desktop icons",
    "pack:mac-arm64": "bun run --cwd apps/desktop pack:mac-arm64",
    "pack:mac-x64": "bun run --cwd apps/desktop pack:mac-x64",
    "pack:win-x64": "bun run --cwd apps/desktop pack:win-x64",
    "pack:linux-x64": "bun run --cwd apps/desktop pack:linux-x64",
    "pack": "bun run --cwd apps/desktop pack",
    "readme:screenshots": "bun run --cwd apps/desktop readme:screenshots",
    "readme:screenshots:demo": "bun run --cwd apps/desktop readme:screenshots:demo",
    "test": "node scripts/test.mjs",
    "test:e2e": "bun run --cwd apps/desktop test:e2e",
    "conversation-round:record": "bun scripts/conversation-round/record.mjs",
    "conversation-round:record:pi": "bun scripts/conversation-round/record-pi.mts",
    "conversation-round:record:claude": "bun scripts/conversation-round/record-claude.mts",
    "conversation-round:record:all": "bun scripts/conversation-round/record-all.mjs",
    "conversation-round:replay": "bun scripts/conversation-round/replay.mjs",
    "gateway-http-round:record:upstream": "bun scripts/gateway-http-round/record-upstream.mts",
    "gateway-http-round:record:gateway": "bun scripts/gateway-http-round/record-gateway.mts",
    "gateway-http-round:record:client-round": "bun scripts/gateway-http-round/record-client-round.mts",
    "gateway-http-round:record:all": "bun scripts/gateway-http-round/record-all.mts",
    "gateway-http-round:record:codex": "bun scripts/gateway-http-round/record-codex-via-gateway.mts",
    "gateway-http-round:replay": "bun scripts/gateway-http-round/replay.mjs",
    "dev:feed-replay-demo": "bun scripts/gateway-http-round/feed-replay-demo.mjs",
    "typecheck": "bunx tsc -b",
    "lint": "bunx biome check .",
    "format": "bunx biome format --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.16",
    "@types/bun": "^1.4.0",
    "@types/node": "^24.13.1",
    "js-yaml": "4.2.0",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "prismjs": "1.30.0"
  }
}
