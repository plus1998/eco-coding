{
  "name": "eco-coding",
  "version": "0.0.1",
  "license": "MIT",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --cwd apps/desktop dev",
    "dev:demo": "bun run --cwd apps/desktop dev:demo",
    "dev:mobile": "cd apps/mobile && flutter run --flavor dev",
    "build": "bun run --cwd apps/desktop build",
    "build:apk": "cd apps/mobile && flutter build apk --flavor prod",
    "supabase:deploy": "node scripts/supabase-deploy.mjs",
    "icons": "bun run --cwd apps/desktop icons",
    "pack:mac-arm64": "bun run --cwd apps/desktop pack:mac-arm64",
    "pack:mac-x64": "bun run --cwd apps/desktop pack:mac-x64",
    "pack:win-x64": "bun run --cwd apps/desktop pack:win-x64",
    "pack:linux-x64": "bun run --cwd apps/desktop pack:linux-x64",
    "pack": "bun run --cwd apps/desktop pack",
    "readme:screenshots": "bun run --cwd apps/desktop readme:screenshots",
    "readme:screenshots:demo": "bun run --cwd apps/desktop readme:screenshots:demo",
    "test": "node scripts/test.mjs",
    "typecheck": "bunx tsc -b",
    "lint": "bunx biome check .",
    "format": "bunx biome format --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.16",
    "@types/bun": "^1.3.14",
    "@types/node": "^24.13.1",
    "js-yaml": "4.2.0",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "prismjs": "1.30.0"
  }
}
