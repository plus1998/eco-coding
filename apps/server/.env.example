# Required — at least 32 characters
ECO_SERVER_TOKEN_SECRET=change-me-to-at-least-32-random-characters

# Optional
ECO_SERVER_HOST=127.0.0.1
ECO_SERVER_PORT=3128
ECO_SERVER_MONGODB_URI=mongodb://127.0.0.1:27017/eco-coding
# Optional override when the URI does not include the database name.
# ECO_SERVER_MONGODB_DATABASE=eco-coding
# If Redis requires a password (default: redis://127.0.0.1:6379)
# ECO_SERVER_REDIS_PASSWORD=
ECO_ACCESS_TOKEN_TTL_SECONDS=900
ECO_REFRESH_TOKEN_TTL_SECONDS=5184000
ECO_PAIRING_TTL_SECONDS=300
ECO_RPC_TIMEOUT_MS=30000
