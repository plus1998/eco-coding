[Unit]
Description=Eco Center Server
Documentation=https://github.com/eco-coding/eco-coding
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/eco/server
EnvironmentFile=/opt/eco/server/.env
Environment=ECO_SERVER_HOST=0.0.0.0
ExecStart=/opt/eco/server/eco-server
Restart=on-failure
RestartSec=5
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
