{
  "name": "@eco/desktop",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "main": "dist/main/index.js",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:electron": "bun run build:main && bun run build:preload && env VITE_DEV_SERVER_URL=http://127.0.0.1:5173/ electron .",
    "build": "vite build && bun run build:main && bun run build:preload",
    "build:main": "bun build src/main/index.ts --target=node --external electron --outdir dist/main",
    "build:preload": "bun build src/preload/index.ts --target=node --format=cjs --external electron --outfile dist/preload/index.cjs"
  },
  "dependencies": {
    "@eco/runtime": "workspace:*",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^37.0.0",
    "framer-motion": "^12.0.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "vite": "^7.0.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0"
  }
}
