{
  "name": "@eco/desktop",
  "version": "0.0.0",
  "description": "Eco Coding desktop app",
  "author": "Eco Coding",
  "type": "module",
  "private": true,
  "main": "dist/main/index.js",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:renderer": "vite --host 127.0.0.1 --strictPort",
    "dev:electron": "node scripts/dev.mjs",
    "dev:cdp": "node scripts/dev.mjs --remote-debugging-port=9222",
    "smoke:feed-loading": "node scripts/smoke-feed-loading.mjs",
    "smoke:subagent-drawer": "node scripts/smoke-subagent-drawer.mjs",
    "smoke:codex-session-modes": "node scripts/smoke-codex-session-modes.mjs",
    "smoke:codex-multi-agent": "node scripts/smoke-codex-multi-agent.mjs",
    "build": "vite build && bun run build:main && bun run build:preload",
    "build:main": "bun build src/main/index.ts --target=node --external electron --external @anthropic-ai/claude-agent-sdk --external node-pty --outdir dist/main",
    "build:preload": "bun build src/preload/index.ts --target=node --format=cjs --external electron --outfile dist/preload/index.cjs",
    "postinstall": "electron-rebuild -f -w node-pty",
    "icons": "node scripts/generate-icons.mjs",
    "pack": "bun run build && node scripts/pack-local.mjs",
    "pack:mac-arm64": "bun run build && electron-builder --mac dmg --arm64",
    "pack:win-x64": "bun run build && electron-builder --win nsis --x64",
    "pack:linux-x64": "bun run build && electron-builder --linux AppImage --x64"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.220",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/view": "^6.43.7",
    "@eco/gateway": "workspace:*",
    "@eco/openai-anthropic-bridge": "workspace:*",
    "@eco/shared": "workspace:*",
    "@openai/codex": "0.142.5",
    "@uiw/react-codemirror": "^4.25.11",
    "fix-path": "^5.0.0",
    "ghostty-web": "^0.4.0",
    "gitdiff-parser": "^0.3.1",
    "i18next": "^25.3.2",
    "node-pty": "^1.0.0",
    "react-complex-tree": "^2.6.2",
    "react-diff-view": "^3.3.3",
    "react-i18next": "^15.6.1",
    "zod": "^4.4.3"
  },
  "optionalDependencies": {
    "@anthropic-ai/claude-agent-sdk-darwin-arm64": "0.3.220",
    "@anthropic-ai/claude-agent-sdk-linux-x64": "0.3.220",
    "@anthropic-ai/claude-agent-sdk-win32-x64": "0.3.220"
  },
  "devDependencies": {
    "@eco/model-router": "workspace:*",
    "@eco/runtime": "workspace:*",
    "@eco/workspace": "workspace:*",
    "@electron/rebuild": "^3.7.2",
    "@types/qrcode.react": "^3.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/refractor": "3.4.1",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^37.0.0",
    "electron-builder": "^26.0.12",
    "framer-motion": "^12.0.0",
    "lucide-react": "^0.468.0",
    "playwright-core": "^1.61.1",
    "qrcode.react": "^4.2.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "refractor": "3.6.0",
    "remark-gfm": "^4.0.1",
    "vite": "^7.0.0",
    "zustand": "^5.0.0"
  }
}
